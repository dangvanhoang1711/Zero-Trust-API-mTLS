{
  "realm": "zero-trust",
  "enabled": true,
  "sslRequired": "none",
  "defaultSignatureAlgorithm": "ES256",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "api-gateway",
      "name": "api-gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "enabled": true
    },
    {
      "clientId": "demo-client",
      "name": "demo-client",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "enabled": true,
      "protocolMappers": [
        {
          "name": "audience-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "cnf-thumbprint",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "cnf",
            "claim.value": "{\"x5t#S256\":\"__CLIENT_CERT_THUMBPRINT__\"}",
            "jsonType.label": "JSON",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-client-mismatch",
      "name": "demo-client-mismatch",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-client-mismatch-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "enabled": true,
      "protocolMappers": [
        {
          "name": "audience-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "cnf-thumbprint-mismatch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "cnf",
            "claim.value": "{\"x5t#S256\":\"__CLIENT_MISMATCH_THUMBPRINT__\"}",
            "jsonType.label": "JSON",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "demo-client-dpop",
      "name": "demo-client-dpop",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "demo-client-dpop-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "enabled": true,
      "protocolMappers": [
        {
          "name": "audience-api-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "api-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "cnf-jkt",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "cnf",
            "claim.value": "{\"jkt\":\"NEj53kHq7gvIzJDw1FrVAaOcWTJByOcsDqDoLzaZyrQ\"}",
            "jsonType.label": "JSON",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-pass",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "ecdsa-generated",
        "providerId": "ecdsa-generated",
        "subType": "default",
        "config": {
          "priority": ["100"],
          "algorithm": ["ES256"],
          "ecdsaEllipticCurveKey": ["P-256"],
          "maxIterationCount": ["1"],
          "enabled": ["true"],
          "active": ["true"]
        }
      }
    ]
  }
}
